# 環境変数の定義・バリデーションの正本は src/env.ts（t3-env）。
# クライアント公開変数は VITE_ 接頭辞が必須。

# --- 必須 ---
# Supabase プロジェクトの URL と公開（publishable / anon）キー
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- 任意 ---
# アプリ名（未設定可）
VITE_APP_TITLE=
# アプリの公開 URL。OGP 画像などの絶対 URL 生成に使用（未設定時は http://localhost:3000）
VITE_APP_URL=
# サーバー URL（未設定可）
SERVER_URL=
